{
  "compilerOptions": {
    // General
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "target": "ESNext",

    // Modules
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,

    // Type Checking & Safety
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "@solid-slopkit/threejs": ["../../packages/threejs/src/index.ts"],
      "@solid-slopkit/threejs/controls": ["../../packages/threejs/src/controls/index.ts"],
      "@solid-slopkit/threejs/webgpu": ["../../packages/threejs/src/webgpu/index.ts"]
    }
  },
  "include": ["src", "*.ts", "file-routes.d.ts"]
}
